{
    "name": "@ehfuse/mindmap",
    "version": "0.2.1",
    "description": "Mind map for React + MUI — map and outline views of one tree, formatting toolbar, drag to move, undo, SVG export",
    "main": "dist/index.js",
    "module": "dist/index.esm.js",
    "types": "dist/index.d.ts",
    "sideEffects": false,
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.esm.js",
            "require": "./dist/index.js"
        }
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "node build.js",
        "typecheck": "tsc --noEmit -p tsconfig.json",
        "prepublishOnly": "npm run build"
    },
    "keywords": [
        "react",
        "mindmap",
        "mind-map",
        "outliner",
        "outline",
        "tree",
        "mui",
        "material-ui"
    ],
    "author": "김영진 (Kim Young Jin) <ehfuse@gmail.com>",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/ehfuse/mindmap.git",
        "directory": "packages/mindmap"
    },
    "publishConfig": {
        "access": "public"
    },
    "peerDependencies": {
        "@emotion/react": "^11.0.0",
        "@emotion/styled": "^11.0.0",
        "@mui/icons-material": "^5.0.0 || ^6.0.0 || ^7.0.0",
        "@mui/material": "^5.0.0 || ^6.0.0 || ^7.0.0",
        "react": "^18.0.0 || ^19.0.0",
        "react-dom": "^18.0.0 || ^19.0.0"
    },
    "devDependencies": {
        "@emotion/react": "^11.13.3",
        "@emotion/styled": "^11.13.0",
        "@mui/icons-material": "^7.3.5",
        "@mui/material": "^7.3.5",
        "@types/react": "^19.0.0",
        "@types/react-dom": "^19.0.0",
        "esbuild": "^0.24.0",
        "react": "^19.0.0",
        "react-dom": "^19.0.0",
        "typescript": "^5.6.3"
    },
    "dependencies": {
        "@ehfuse/outliner": "^0.2.1",
        "@ehfuse/toolbar-icons": "^0.1.1"
    }
}